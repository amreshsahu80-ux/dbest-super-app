{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {"source": "/owner/", "destination": "/owner", "permanent": true},
    {"source": "/vaahak", "destination": "/Vaahak", "permanent": true},
    {"source": "/vaahak/", "destination": "/Vaahak", "permanent": true},
    {"source": "/Vaahak/", "destination": "/Vaahak", "permanent": true},
    {"source": "/servicepartner", "destination": "/ServicePartner", "permanent": true},
    {"source": "/servicepartner/", "destination": "/ServicePartner", "permanent": true},
    {"source": "/ServicePartner/", "destination": "/ServicePartner", "permanent": true},
    {"source": "/superadmin", "destination": "/SuperAdmin", "permanent": true},
    {"source": "/superadmin/", "destination": "/SuperAdmin", "permanent": true},
    {"source": "/SuperAdmin/", "destination": "/SuperAdmin", "permanent": true}
  ],
  "rewrites": [
    {"source": "/owner", "destination": "/index.html"},
    {"source": "/ServicePartner", "destination": "/index.html"},
    {"source": "/SuperAdmin", "destination": "/index.html"},
    {"source": "/Vaahak/runtime-config.js", "destination": "/runtime-config.js"},
    {"source": "/vaahak/runtime-config.js", "destination": "/runtime-config.js"},
    {"source": "/Vaahak", "destination": "/vaahak.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), usb=(), browsing-topics=()"}
      ]
    },
    {
      "source": "/owner",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}
      ]
    },
    {
      "source": "/ServicePartner",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}
      ]
    },
    {
      "source": "/SuperAdmin",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}
      ]
    },
    {
      "source": "/Vaahak",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/vaahak.html",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/runtime-config.js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/Vaahak/runtime-config.js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/vaahak-(.*).js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/service-partner-(.*).js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/super-admin-(.*).js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate"}
      ]
    }
  ]
}