{
  "version": "1.1",
  "platform": "DBest Super Platform",
  "environment_scope": "ai-safe-ui-test",
  "registrations": {
    "user": {"primary": "razorpay", "secondary": null},
    "vaahak": {"primary": "razorpay", "secondary": null},
    "service_partner": {"primary": "razorpay", "secondary": null},
    "vendor": {"primary": "razorpay", "secondary": null}
  },
  "ecommerce": {
    "primary": "razorpay",
    "secondary": "payu"
  },
  "cab": {
    "gateway": null,
    "methods": ["cash_to_driver", "upi_to_driver"]
  },
  "home_jobs": {
    "gateway": null,
    "methods": ["cash_to_service_provider", "upi_to_service_provider"]
  },
  "repairing": {
    "gateway": null,
    "methods": ["cash_to_partner", "upi_to_partner"]
  },
  "forms": {
    "primary": "payu",
    "secondary": null
  },
  "rules": {
    "registration_gateway_opens_only_when_fee_is_greater_than_zero": true,
    "cab_gateway_must_never_open": true,
    "home_jobs_gateway_must_never_open": true,
    "repairing_gateway_must_never_open": true,
    "primary_gateway_is_default_button": true,
    "secondary_gateway_is_alternate_button": true
  }
}
